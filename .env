MODE=development
# 项目标题
VITE_TITLE=通用后台管理框架
# api前缀
VITE_API_PREFIX=/congyu-official-website
# api代理地址
VITE_API_URL=http://www.zscongyu.cn/congyu-official-website
#VITE_API_URL=http://testservice.ehanghai.cn/ivd-api/
# 二级路径
VITE_PUBLIC_PATH=/
# OAuth2 客户端凭证（Base64 编码的 client_id:client_secret）
# 注意：SPA 中此值仍会暴露在客户端 bundle，属 Public Client 已知限制
# 原值为 congyu_web:123456，已迁移至此处避免硬编码
VITE_CLIENT_CREDENTIALS=Y29uZ3l1X3dlYjoxMjM0NTY=
